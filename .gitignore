/data/
/learnme.toml
*.env
!docs/slack.env.example

# The user's own profile; only the examples are part of the repo.
/profile/*.md
!/profile/*.example.md
!/profile/README.md

# Python
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# Keys
id_*
*.pem
*.key
