# learnMe Slack bridge. Copy to <data dir>/slack.env (data/slack.env by default) and chmod 600.
# The bridge stays off unless this file exists, the tokens are valid, and SLACK_MODE is not "off".

# Basic Information → App-Level Tokens, scope connections:write
SLACK_APP_TOKEN=xapp-...
# OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Optional: User OAuth Token, to reply as yourself instead of as the bot
# SLACK_USER_TOKEN=xoxp-...

# Who the owner is (you). Your member id: Slack profile → ⋮ → Copy member ID. Or give your email instead.
SLACK_OWNER_ID=U0123456789
# SLACK_OWNER_EMAIL=you@example.com

# auto: reply on its own when it can · draft: hand every reply to you · off: don't connect
SLACK_MODE=auto
# Limits
# SLACK_MAX_REPLIES_PER_HOUR=20
# SLACK_MESSAGES_PER_DAY=150
# SLACK_TASKS_PER_DAY=10
# SLACK_NOTES_PER_HOUR=20
# Seconds to wait for more messages in a conversation before handing them over
# SLACK_DEBOUNCE_S=40
# Text appended to automatic replies; leave empty for none (default: "— via <name>'s assistant")
# SLACK_REPLY_MARKER=
# Backend for Slack windows (default: the default backend)
# SLACK_BACKEND=claude
# Extra tool-name prefixes to refuse on other people's requests, comma-separated
# SLACK_BLOCKED_TOOL_PREFIXES=mcp__mail_,mcp__drive_
